# Existing Supabase connection
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DB_SSL=true

# Old local MySQL database
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=pc_rental
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=

# MySQL DATETIME values are treated as this local offset during migration.
SOURCE_TIMEZONE_OFFSET=+07:00

# Set true when you want Supabase to become a mirror of the old MySQL data.
# WARNING: this clears the existing rows in the destination tables.
MIGRATION_CLEAR_DEST=false
