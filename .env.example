PORT=3000

# Supabase PostgreSQL connection string.
# Copy the exact URI from Supabase Dashboard -> Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Use true for Supabase. Set false only for a local non-SSL PostgreSQL server.
DB_SSL=true
DB_POOL_MAX=10

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d
DEMO_PAYMENT_VERIFY_RESULT=fail

# Optional PromptPay / webhook settings
PROMPTPAY_ID=
PAYMENT_QR_URL=
PAYMENT_WEBHOOK_SECRET=
