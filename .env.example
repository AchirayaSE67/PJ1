PORT=3000

# Supabase PostgreSQL connection string.
# Copy the exact URI from Supabase Dashboard -> Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Use true for Supabase. Set false only for a local non-SSL PostgreSQL server.
DB_SSL=true
DB_POOL_MAX=10

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d
DEMO_PAYMENT_VERIFY_RESULT=fail

# รหัสลับสำหรับเรียก /api/access/verify เพื่อตรวจคีย์เข้าเครื่อง (ตั้งเป็นข้อความสุ่มยาวๆ)
AGENT_SECRET=change_this_agent_secret

# Optional PromptPay / webhook settings
PROMPTPAY_ID=
PAYMENT_QR_URL=
PAYMENT_WEBHOOK_SECRET=

# --- ส่งอีเมล (ยืนยันอีเมล / ลืมรหัสผ่าน) ผ่าน Brevo ---
# สมัครที่ brevo.com -> SMTP & API -> API Keys (ใช้คีย์ชนิด API key v3 ไม่ใช่ SMTP key)
BREVO_API_KEY=
# อีเมลผู้ส่ง ต้องเป็นอีเมลที่ยืนยันแล้วใน Brevo (Senders, Domains & Dedicated IPs -> Senders)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SunFlowerPC
# URL เว็บจริง ใช้สร้างลิงก์ในอีเมล เช่น https://ชื่อเว็บ.onrender.com (ไม่ต้องมี / ท้าย)
APP_URL=
